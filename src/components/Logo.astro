---
interface Props {
  class?: string;
  showWordmark?: boolean;
}
const { class: className = '', showWordmark = true } = Astro.props;
---

<span class={`inline-flex flex-col items-center gap-1 ${className}`}>
  <img
    src="/verdescence-mark.svg"
    alt="Verdescence mark"
    class="h-8 w-auto"
    loading="eager"
  />

  {showWordmark && (
    <span class="font-display text-sm font-semibold tracking-tight lowercase leading-none">
      verdescence
    </span>
  )}
</span>