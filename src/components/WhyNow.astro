---
const drivers = [
  {
    title: 'Automation has come of age',
    body: 'Industrial automation and AI perception are finally robust enough for the unstructured reality of the open field.',
  },
  {
    title: 'The labour gap is structural',
    body: "Workforce decline isn't a cycle — it's a trend. Automation has moved from option to necessity.",
  },
  {
    title: 'Resources demand precision',
    body: 'Water and fertilizer are costlier and scarcer every year — precision delivery has become the only sustainable path.',
  },
];
---

<section id="why-now" class="section">
  <div class="container-content">
    <div class="max-w-2xl">
      <p class="eyebrow mb-4">Why now</p>
      <h2 class="text-3xl font-semibold sm:text-4xl">
        Three shifts converging on the same field.
      </h2>
    </div>

    <div class="mt-16 grid gap-px overflow-hidden rounded-2xl border border-ink/5 bg-ink/5 md:grid-cols-3">
      {drivers.map((d, i) => (
        <div class="bg-cream px-6 py-10 sm:px-8">
          <span class="font-display text-sm font-semibold text-sage-600">0{i + 1}</span>
          <h3 class="mt-4 font-display text-xl font-semibold">{d.title}</h3>
          <p class="mt-3 text-sm leading-relaxed text-ink-500">{d.body}</p>
        </div>
      ))}
    </div>
  </div>
</section>