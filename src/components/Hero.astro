<section id="top" class="relative overflow-hidden">
  {/* Soft botanical backdrop */}
  <div class="pointer-events-none absolute inset-0 -z-10">
    <div class="absolute -top-24 -right-24 h-96 w-96 rounded-full bg-botanic/8 blur-3xl"></div>
    <div class="absolute top-40 -left-32 h-80 w-80 rounded-full bg-sage/10 blur-3xl"></div>
  </div>

  <div class="container-content py-24 sm:py-32 lg:py-40">
    <div class="max-w-3xl">
      <p class="eyebrow mb-6">Green Automation &middot; Robot Farmers</p>

      <h1 class="text-4xl font-semibold leading-[1.05] sm:text-6xl lg:text-7xl">
        Green automation for the hands that feed us.
      </h1>

      <p class="mt-8 max-w-xl text-lg leading-relaxed text-ink-500 sm:text-xl">
        Verdescence brings industrial automation and intelligent machines to
        agriculture — helping farmers save water, reduce inputs, and tackle the
        growing labour shortage.
      </p>

      <div class="mt-10 flex flex-wrap items-center gap-4">
        <a href="#contact" class="btn-primary">Talk to us</a>
        <a href="#solution" class="btn-secondary">See the approach</a>
      </div>
    </div>

    {/* Placeholder image band */}
    <div class="mt-16 overflow-hidden rounded-3xl border border-ink/5 bg-gradient-to-br from-botanic/12 to-sage/15 lg:mt-24">
      <div class="flex aspect-[16/7] items-center justify-center">
        <p class="text-sm text-ink-400">Field imagery placeholder · robot in-row · to be replaced</p>
      </div>
    </div>
  </div>
</section>