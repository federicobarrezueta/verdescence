---
const capabilities = [
  {
    title: 'Automation',
    body: 'Industrial-grade automation brought to the field — machines that plant, tend, and harvest with repeatability and precision, not guesswork.',
  },
  {
    title: 'Resource efficiency',
    body: 'Targeted delivery of water and fertilizer — only where needed, only when needed — reducing waste and lowering input costs.',
  },
  {
    title: 'Labour relief',
    body: 'Robot farmers that take on the repetitive, physically demanding work — filling the gaps an ageing, shrinking workforce can no longer cover.',
  },
];
---

<section id="solution" class="section bg-cream-200/50">
  <div class="container-content">
    <div class="grid gap-12 lg:grid-cols-2 lg:gap-20">
      <div>
        <p class="eyebrow mb-4">The solution</p>
        <h2 class="text-3xl font-semibold sm:text-4xl">
          Green automation for the working field.
        </h2>
        <p class="mt-6 text-lg text-ink-500">
          Verdescence brings industrial automation and intelligent machines out
          of the factory and into the row — saving resources, reducing labour
          strain, and making sustainable farming the practical choice.
        </p>
        <a href="#approach" class="mt-8 inline-flex items-center gap-2 text-sm font-semibold text-botanic">
          How it works →
        </a>
      </div>

      <ul class="grid gap-4">
        {capabilities.map((c) => (
          <li class="rounded-2xl border border-ink/5 bg-cream p-6 sm:p-8">
            <h3 class="font-display text-xl font-semibold text-botanic">{c.title}</h3>
            <p class="mt-3 text-sm leading-relaxed text-ink-500">{c.body}</p>
          </li>
        ))}
      </ul>
    </div>
  </div>
</section>